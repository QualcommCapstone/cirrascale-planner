# ---- app ----
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:3000

# ---- provider selection (mock mode by default; no external services needed) ----
EMBEDDING_PROVIDER=mock        # mock | cirrascale
VECTOR_STORE_PROVIDER=memory   # memory | qdrant
LLM_PROVIDER=mock              # mock | cirrascale

# ---- Cirrascale (used only when a provider above is set to 'cirrascale') ----
# Server-only. Never expose to the browser.
CIRRASCALE_API_KEY=
CIRRASCALE_BASE_URL=https://aisuite.cirrascale.com/apis/v2
CIRRASCALE_MODEL=Llama-3.1-8B
# Cirrascale embedding model (OpenAI-compatible /embeddings endpoint):
#   BAAI/bge-base-en-v1.5  -> 768-dim (default)
#   BAAI/bge-large-en-v1.5 -> 1024-dim
# Set EMBEDDING_PROVIDER=cirrascale above to use real embeddings.
CIRRASCALE_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=64
# Optional instruction prepended to QUERIES only. Left empty on purpose: the
# hosted BGE scored worse with the usual BGE instruction. To experiment set e.g.
# "Represent this sentence for searching relevant passages: "
EMBEDDING_QUERY_INSTRUCTION=
REQUEST_TIMEOUT_SECONDS=60

# ---- Qdrant (used only when VECTOR_STORE_PROVIDER=qdrant) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=places
VECTOR_DIM=384
