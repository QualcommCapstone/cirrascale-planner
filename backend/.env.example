# Copy to backend/.env for local overrides. Never commit .env.

# Sent with every scraper request so site owners know who we are.
# Wikimedia asks for a way to contact you: put your team email in here.
SCRAPER_USER_AGENT="AI100TravelPlanner/0.1 (ASU capstone student project; https://github.com/QualcommCapstone/cirrascale-planner; you@asu.edu)"

# Minimum seconds between two requests to the same website.
SCRAPER_MIN_DELAY_S=3
