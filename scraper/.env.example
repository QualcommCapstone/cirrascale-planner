# Copy to scraper/.env for local settings. Never commit .env.

# Sent with every request so site owners know who we are.
# Wikimedia asks for a way to contact you: add your team email.
SCRAPER_USER_AGENT="AI100TravelPlanner-scraper/0.1 (ASU capstone student project; https://github.com/QualcommCapstone/cirrascale-planner; you@asu.edu)"

# Minimum seconds between two requests to the same host.
SCRAPER_WIKIDATA_DELAY_S=1
SCRAPER_OVERPASS_DELAY_S=5
SCRAPER_SEARCH_DELAY_S=3
SCRAPER_CRAWL_DELAY_S=3

# Overpass instance (the main public one by default).
# SCRAPER_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Full path to uv, if it isn't on PATH (collect runs backend/ and apps/api with it).
# SCRAPER_UV=C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\...\uv.exe
