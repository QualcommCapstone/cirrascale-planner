{
  "name": "cirrascale-planner-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "start:web": "npm run start --workspace apps/web",
    "lint:web": "npm run lint --workspace apps/web",
    "test:web": "npm run test --workspace apps/web",
    "test:api": "cd apps/api && uv run pytest",
    "contracts:generate": "cd apps/api && uv run python scripts/export_openapi.py > ../../packages/contracts/openapi.json && cd ../.. && npm run generate --workspace packages/contracts"
  },
  "engines": {
    "node": ">=20"
  }
}
